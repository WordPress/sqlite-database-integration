{
	"name": "wordpress/mysql-parser",
	"type": "library",
	"description": "A fast, table-driven MySQL parser generated from the official MySQL 8.4 LTS grammar.",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.2"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"require-dev": {
		"phpunit/phpunit": "^8.5"
	},
	"scripts": {
		"test": "phpunit",
		"build-grammar": [
			"./bin/build-grammar"
		],
		"benchmark": [
			"@php tests/benchmark.php",
			"@php -d opcache.enable_cli=1 -d opcache.jit_buffer_size=64M -d opcache.jit=tracing tests/benchmark.php"
		]
	}
}
